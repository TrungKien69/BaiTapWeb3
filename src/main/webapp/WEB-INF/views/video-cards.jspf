<%@ page pageEncoding="UTF-8" %>
<div class="videogrid"><c:forEach items="${videos}" var="v"><article class="panel videocard"><c:url var="detail" value="/video/detail"><c:param name="id" value="${v.videoId}"/></c:url><a class="poster" href="${fn:escapeXml(detail)}">
<c:choose><c:when test="${empty v.poster}"><span class="playmark" aria-hidden="true">▶</span><span class="posterlabel">VIDEOHUB</span></c:when><c:otherwise><c:choose><c:when test="${fn:startsWith(v.poster,'http')}"><c:set var="posterUrl" value="${v.poster}"/></c:when><c:otherwise><c:url var="posterUrl" value="/image"><c:param name="fname" value="${v.poster}"/></c:url></c:otherwise></c:choose><img src="${fn:escapeXml(posterUrl)}" alt="Ảnh bìa video" loading="lazy" referrerpolicy="no-referrer"></c:otherwise></c:choose></a><div class="videobody"><h2><a href="${fn:escapeXml(detail)}"><c:out value="${v.title}"/></a></h2><p class="muted"><c:out value="${v.owner.fullName}"/> · ${v.views} lượt xem</p><c:if test="${myVideos}"><div class="videocommands"><span class="badge ${v.active == 1 ? 'on' : 'off'}">${v.active == 1 ? 'Công khai' : 'Ẩn'}</span><a href="${pageContext.request.contextPath}/video/edit?id=${v.videoId}">Sửa</a><form method="post" action="${pageContext.request.contextPath}/video/delete" onsubmit="return confirm('Xóa video này?');"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="id" value="${v.videoId}"><button class="danger" type="submit">Xóa</button></form></div></c:if></div></article></c:forEach></div>
<c:if test="${empty videos}"><div class="panel empty"><h2>Chưa có video</h2><p>Video mới sẽ xuất hiện tại đây.</p><a class="button" href="${pageContext.request.contextPath}/video/add">Đăng video đầu tiên</a></div></c:if>

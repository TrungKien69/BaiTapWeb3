<%@ page pageEncoding="UTF-8" %>
<%@ include file="common/header.jspf" %>
<div class="authlayout"><section class="authintro"><p class="eyebrow">CHÀO MỪNG ĐẾN VIDEOHUB</p><h1>Chia sẻ video.<br>Kết nối ý tưởng.</h1><p class="muted">Tạo tài khoản để đăng tải và quản lý những video của bạn.</p><div class="introshape" aria-hidden="true">▶</div></section><section class="panel authpanel">
<c:choose><c:when test="${mode == 'register'}"><h2>Tạo tài khoản</h2></c:when><c:when test="${mode == 'activate'}"><h2>Kích hoạt tài khoản</h2></c:when><c:when test="${mode == 'forgot'}"><h2>Quên mật khẩu</h2></c:when><c:when test="${mode == 'reset'}"><h2>Đặt lại mật khẩu</h2></c:when><c:otherwise><h2>Đăng nhập</h2></c:otherwise></c:choose>
<c:if test="${not empty flash}"><p class="notice" role="status"><c:out value="${flash}"/></p></c:if><c:if test="${not empty error}"><p class="notice error" role="alert"><c:out value="${error}"/></p></c:if>
<c:if test="${demoMail}"><p class="demo-banner">Chế độ demo: thư được lưu cục bộ, không gửi ra email thật. <a href="${pageContext.request.contextPath}/demo/mail">Xem hộp thư demo</a></p></c:if>
<c:choose><c:when test="${mode == 'register'}"><c:set var="action" value="register"/></c:when><c:when test="${mode == 'activate'}"><c:set var="action" value="activate"/></c:when><c:when test="${mode == 'forgot'}"><c:set var="action" value="forgot-password"/></c:when><c:when test="${mode == 'reset'}"><c:set var="action" value="reset-password"/></c:when><c:otherwise><c:set var="action" value="login"/></c:otherwise></c:choose>
<form class="accountform" method="post" action="${pageContext.request.contextPath}/${action}"><input type="hidden" name="csrf" value="${sessionScope.csrf}">
<c:if test="${mode == 'register'}"><label for="fullName">Họ tên</label><input id="fullName" name="fullName" maxlength="100" required autocomplete="name"><label for="username">Tên đăng nhập</label><input id="username" name="username" pattern="[A-Za-z0-9_]{3,32}" minlength="3" maxlength="32" required autocomplete="username"><small>3–32 chữ không dấu, số hoặc dấu gạch dưới.</small></c:if>
<c:choose><c:when test="${mode == 'login'}"><label for="identity">Tên đăng nhập hoặc email</label><input id="identity" name="identity" maxlength="254" required autocomplete="username"></c:when><c:otherwise><label for="email">Email</label><input id="email" type="email" name="email" value="${fn:escapeXml(email)}" maxlength="254" required autocomplete="email"></c:otherwise></c:choose>
<c:if test="${mode == 'activate' or mode == 'reset'}"><label for="otp">Mã OTP</label><input id="otp" name="otp" pattern="[0-9]{6}" maxlength="6" minlength="6" inputmode="numeric" autocomplete="one-time-code" required><small>Mã gồm 6 số, có hiệu lực 5 phút và chỉ dùng một lần.</small></c:if>
<c:if test="${mode == 'register' or mode == 'login' or mode == 'reset'}"><label for="password">${mode == 'reset' ? 'Mật khẩu mới' : 'Mật khẩu'}</label><input id="password" type="password" name="password" minlength="8" maxlength="128" required autocomplete="${mode == 'login' ? 'current-password' : 'new-password'}"></c:if>
<c:if test="${mode == 'register' or mode == 'reset'}"><label for="confirm">Nhập lại mật khẩu</label><input id="confirm" type="password" name="confirm" minlength="8" maxlength="128" required autocomplete="new-password"></c:if>
<button type="submit">${mode == 'register' ? 'Đăng ký và gửi OTP' : mode == 'activate' ? 'Kích hoạt tài khoản' : mode == 'forgot' ? 'Gửi mã xác nhận' : mode == 'reset' ? 'Đổi mật khẩu' : 'Đăng nhập'}</button></form>
<c:if test="${mode == 'activate' or mode == 'reset'}"><form class="resend" method="post" action="${pageContext.request.contextPath}/otp/resend"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><label for="resend-email">Email nhận mã mới</label><input type="email" id="resend-email" name="email" value="${fn:escapeXml(email)}" required maxlength="254"><input type="hidden" name="purpose" value="${mode == 'reset' ? 'RESET' : 'ACTIVATE'}"><button class="secondary" type="submit">Gửi lại OTP</button><small>Đợi ít nhất 60 giây giữa hai lần gửi.</small></form></c:if>
<div class="authlinks"><a href="${pageContext.request.contextPath}/login">Đăng nhập</a><a href="${pageContext.request.contextPath}/register">Đăng ký</a><a href="${pageContext.request.contextPath}/forgot-password">Quên mật khẩu?</a><a href="${pageContext.request.contextPath}/activate">Chưa kích hoạt?</a></div></section></div>
<%@ include file="common/footer.jspf" %>
